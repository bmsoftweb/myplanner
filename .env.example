# Porta do servidor (padrão 3000)
PORT=3000

# Segredo que assina o cookie de sessao. OBRIGATORIO em producao: sem ele cada
# instancia assina com uma chave propria e os usuarios caem sozinhos.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MySQL
MYSQL_HOST=45.224.130.145
MYSQL_PORT=3306
MYSQL_USER=bmsoftadm
MYSQL_PASSWORD=
MYSQL_DATABASE=myplanner

# Pasta onde ficam os comprovantes anexados aos lançamentos
UPLOAD_DIR=uploads

# SMTP para ativação de conta, recuperação e envio de senha ao usuário.
# Sem estas variáveis o sistema continua funcionando: a chave de ativação
# aparece na própria tela em vez de ser enviada por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
